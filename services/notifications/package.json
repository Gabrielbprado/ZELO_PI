{
  "name": "zelo-notifications-service",
  "version": "1.0.0",
  "private": true,
  "description": "Microserviço de notificações do ZELO — consome eventos de domínio, persiste o inbox e envia push Expo.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "amqplib": "^0.10.9",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
