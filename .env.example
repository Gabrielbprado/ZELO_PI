# Banco usado pelo backend local (npm start).
# Também funciona com o Postgres do Docker Compose na porta 55432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/zero_marketplace?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/zero_marketplace_test?schema=public

# Segredos locais de desenvolvimento. Troque por valores próprios fora da máquina local.
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_9876543210abcdef

# API e frontend local.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:4000,http://localhost:8081,http://localhost:19006
EXPO_PUBLIC_API_BASE_URL=

# ML fica desligado por padrão. Para ativar, inicie também o serviço ML.
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=local_dev_ml_token_change_me_please

# Variáveis usadas pelo Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zero_marketplace
DB_PORT=55432
API_PORT=4000
ML_PORT=8001
