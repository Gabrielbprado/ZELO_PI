# =============================================================================
# ZELO — Variáveis de Ambiente Obrigatórias
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite o `.env` real (contém segredos).
# =============================================================================

# -----------------------------------------------------------------------------
# Básicos
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# Banco de Dados (OBRIGATÓRIO)
# -----------------------------------------------------------------------------
# PostgreSQL com extensão PostGIS para geolocalização
# Ex: postgresql://user:pass@localhost:5432/zelo?schema=public
DATABASE_URL=

# -----------------------------------------------------------------------------
# Autenticação JWT (OBRIGATÓRIO - mín. 32 chars cada)
# -----------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS (OBRIGATÓRIO em produção)
# -----------------------------------------------------------------------------
# Origens permitidas, separadas por vírgula
# Ex: https://app.zelo.com,https://admin.zelo.com
CORS_ORIGINS=http://localhost:8081

# -----------------------------------------------------------------------------
# Servir Frontend Web (OPCIONAL)
# -----------------------------------------------------------------------------
# Caminho absoluto para o build do Expo Web (mobile/dist)
# Quando definido, a API serve o app na mesma porta — evita CORS
# WEB_DIST_DIR=/app/mobile/dist

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# Seed de demonstração (ao iniciar a API)
# -----------------------------------------------------------------------------
# auto: semeia só quando o banco está vazio | force: recria sempre | off: nunca
SEED_ON_START=auto

# -----------------------------------------------------------------------------
# Microserviço de Notificações (OPCIONAL)
# -----------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_SERVICE_URL=
NOTIFICATIONS_SERVICE_TOKEN=
NOTIFICATIONS_TIMEOUT_MS=1500

# -----------------------------------------------------------------------------
# Serviço de Recomendação / ML (OPCIONAL)
# -----------------------------------------------------------------------------
ML_ENABLED=true
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
ML_TIMEOUT_MS=700
ML_MODERATION_TIMEOUT_MS=2500
ML_CANDIDATE_LIMIT=150
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000

# -----------------------------------------------------------------------------
# Redis Cache (OPCIONAL — necessário para rastreamento em tempo real e jobs)
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=zelo
CACHE_TTL_CATEGORIES_SEC=3600
CACHE_TTL_PROVIDER_SEC=300
CACHE_TTL_PROVIDER_LIST_SEC=60
CACHE_TTL_REVIEWS_SEC=300

# -----------------------------------------------------------------------------
# RabbitMQ / Eventos (OPCIONAL)
# -----------------------------------------------------------------------------
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=zelo.events
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH=100
EVENT_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Jobs / BullMQ (OPCIONAL - requer Redis)
# -----------------------------------------------------------------------------
JOBS_ENABLED=true
BOOKING_EXPIRY_HOURS=48

# -----------------------------------------------------------------------------
# Admin UI / Bull Board (OBRIGATÓRIO em produção - sem defaults!)
# -----------------------------------------------------------------------------
# REMOVA OS DEFAULTS EM PRODUÇÃO - defina valores seguros via env
ADMIN_UI_USER=
ADMIN_UI_PASSWORD=

# -----------------------------------------------------------------------------
# Asaas / Pagamentos (gateway único: PIX + cartão)
# Com ASAAS_ENABLED=false, PIX e cartão ficam indisponíveis; dinheiro continua
# funcionando. Com o gateway ligado, cobranças reais são criadas e confirmadas
# via webhook `/api/v1/payments/webhook/asaas` (header `asaas-access-token`).
# -----------------------------------------------------------------------------
ASAAS_ENABLED=false
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# Plataforma
# -----------------------------------------------------------------------------
PLATFORM_FEE_PERCENT=12

# Habilita POST /payments/:bookingId/admin/force-confirm (admin only).
# Útil pra reconciliação de suporte quando um webhook falhou OU em ambientes de
# sandbox onde simular PIX não é possível. Desligado por padrão em produção.
ALLOW_ADMIN_FORCE_CONFIRM=true
