# PostgreSQL — ajuste usuário/senha/host conforme sua instalação
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zero_marketplace?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zero_marketplace_test?schema=public"

# Servidor
NODE_ENV=development
PORT=4000

# JWT — OBRIGATÓRIO trocar antes de subir.
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use chaves DIFERENTES para acesso e refresh, ambas com ao menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Serviço de recomendação (ml/). Com ML_ENABLED=false o app segue funcionando:
# o backend usa a ordenação por avaliação e marca strategy="fallback".
ML_ENABLED=true
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=local_dev_ml_token_change_me_please
ML_TIMEOUT_MS=700
ML_CANDIDATE_LIMIT=150
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000

# ---------------------------------------------------------------------------
# Redis — OPCIONAL. Fornece cache de leitura, rate limit compartilhado entre
# instâncias e estado comum do circuit breaker do ML.
#
# Desligado por padrão de propósito: `npm run dev` e os testes precisam subir em
# uma máquina sem Redis. Com REDIS_ENABLED=false a API funciona exatamente como
# antes — mais lenta nas listagens, e com o limite de requisições contado por
# processo em vez de por sistema.
#
# `docker compose up` já sobe um Redis e liga a integração sozinho.
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
# REDIS_URL="redis://localhost:56379"
REDIS_KEY_PREFIX=zelo
CACHE_TTL_CATEGORIES_SEC=3600
CACHE_TTL_PROVIDER_SEC=300
CACHE_TTL_PROVIDER_LIST_SEC=60
CACHE_TTL_REVIEWS_SEC=300
