// ZERO Marketplace — Prisma schema
// Mercado local de serviços (encanador, eletricista, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum BookingUrgency {
  EMERGENCY
  TODAY
  THIS_WEEK
  FLEXIBLE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
}

enum RecEventType {
  IMPRESSION
  CLICK
  BOOKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  name         String
  avatarHue    Int      @default(220)
  city         String?
  neighborhood String?
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true)
  emailVerified Boolean @default(false)
  failedLogins Int      @default(0)
  lockedUntil  DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  pushToken    String?
  // Id do cliente correspondente no Asaas, criado sob demanda no 1º pagamento e reusado
  // nos seguintes. Sem FK: é uma referência a um recurso externo.
  asaasCustomerId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  providerProfile  ProviderProfile?
  refreshTokens    RefreshToken[]
  bookingsAsClient Booking[]        @relation("ClientBookings")
  reviewsWritten   Review[]         @relation("Author")
  reviewsReceived  Review[]         @relation("Target")
  messagesSent     Message[]        @relation("Sender")
  messagesReceived Message[]        @relation("Receiver")
  budgetEstimates  BudgetEstimate[]
  auditLogs        AuditLog[]
  recEvents        RecEvent[]

  @@index([city, neighborhood])
}

model ProviderProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  yearsExp    Int        @default(0)
  jobsDone    Int        @default(0)
  ratingAvg   Float      @default(0)
  ratingCount Int        @default(0)
  kycStatus   KycStatus  @default(PENDING)
  kycVerifiedAt DateTime?
  documentCpf String?    @unique
  available   Boolean    @default(true)
  // Real geolocation as a PostGIS geography point (SRID 4326).
  // Unsupported by Prisma Client — read/written via raw SQL (ST_*) helpers.
  // Replaces the former `latitude`/`longitude` float columns.
  location    Unsupported("geography(Point, 4326)")?
  priceFrom   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  services     ProviderService[]
  bookings     Booking[]
  portfolio    PortfolioItem[]
  categories   ProviderCategory[]
  recEvents    RecEvent[]
  availability ProviderAvailability[]
  timeOff      ProviderTimeOff[]
  documents    ProviderDocument[]

  @@index([available, ratingAvg])
}

enum KycDocType {
  CPF
  RG
  CNH
  ADDRESS_PROOF
  CERTIFICATE
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Documento enviado pelo profissional para verificação (KYC). O `fileKey` é a referência
/// ao arquivo (URL/chave de storage); a moderação é feita por um ADMIN, que aprova/rejeita
/// e dispara a atualização do selo de verificação no perfil.
model ProviderDocument {
  id              String     @id @default(uuid())
  providerId      String
  type            KycDocType
  fileKey         String
  status          DocStatus  @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime   @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerId])
}

enum ReportReason {
  INAPPROPRIATE
  FRAUD
  NO_SHOW
  SAFETY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// Denúncia de um usuário contra outro (opcionalmente ligada a um booking). Moderada por
/// ADMIN. Ids sem FK de propósito: uma denúncia deve sobreviver mesmo que a conta alvo
/// seja removida, para o histórico de moderação.
model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetUserId String
  bookingId    String?
  reason       ReportReason
  description  String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([targetUserId])
}

/// Grade semanal de disponibilidade do profissional. Uma linha por janela de atendimento
/// num dia da semana; os minutos são desde a meia-noite (ex.: 8h = 480, 18h = 1080).
model ProviderAvailability {
  id          String @id @default(uuid())
  providerId  String
  weekday     Int    // 0 = domingo … 6 = sábado
  startMinute Int
  endMinute   Int

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, weekday])
}

/// Bloqueios pontuais (férias, folga, compromisso) que removem horários da agenda.
model ProviderTimeOff {
  id         String   @id @default(uuid())
  providerId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startsAt])
}

model Category {
  id        String   @id
  name      String
  iconKey   String
  hue       Int      @default(220)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  providers ProviderCategory[]
  services  ProviderService[]
  bookings  Booking[]
}

model ProviderCategory {
  providerId String
  categoryId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
}

model ProviderService {
  id          String   @id @default(uuid())
  providerId  String
  categoryId  String
  title       String
  description String?
  priceMin    Int
  priceMax    Int?
  unit        String   @default("servico")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])

  @@index([providerId])
}

model PortfolioItem {
  id         String   @id @default(uuid())
  providerId String
  caption    String?
  hue        Int      @default(220)
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String         @id @default(uuid())
  clientId    String
  providerId  String
  categoryId  String
  title       String
  description String?
  address     String
  scheduledAt DateTime?
  urgency     BookingUrgency @default(FLEXIBLE)
  status      BookingStatus  @default(REQUESTED)
  durationMinutes Int        @default(60)
  priceEstimate Int?
  priceFinal  Int?
  // Onde o serviço foi prestado, como ponto PostGIS (SRID 4326).
  // Unsupported pelo Prisma Client — escrito via $executeRaw (ST_MakePoint),
  // igual a ProviderProfile.location. Usado como âncora geográfica do cliente
  // no recomendador (ST_Centroid sobre os últimos bookings).
  location    Unsupported("geography(Point, 4326)")?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  client   User            @relation("ClientBookings", fields: [clientId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])
  category Category        @relation(fields: [categoryId], references: [id])
  reviews  Review[]
  payment  Payment?
  messages Message[]

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([providerId, scheduledAt])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String
  authorId   String
  targetId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("Author", fields: [authorId], references: [id])
  target  User    @relation("Target", fields: [targetId], references: [id])

  // Uma avaliação por AUTOR por booking: permite avaliação BIDIRECIONAL (o cliente avalia
  // o profissional e o profissional avalia o cliente), cada um uma vez.
  @@unique([bookingId, authorId])
  @@index([targetId])
}

model Message {
  id         String   @id @default(uuid())
  bookingId  String?
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sender   User     @relation("Sender",  fields: [senderId],   references: [id])
  receiver User     @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  amount    Int
  currency  String        @default("BRL")
  method    String        @default("pix")
  status    PaymentStatus @default(PENDING)
  externalId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BudgetEstimate {
  id         String   @id @default(uuid())
  userId     String?
  categoryId String
  answers    Json
  estimateMin Int
  estimateMax Int
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Telemetria do carrossel de recomendação. Cada resposta de
/// GET /recommendations/for-you tem um requestId; as impressões e cliques
/// referenciam esse id, o que permite reconstruir o conjunto exibido e treinar
/// com dados reais (positivo = CLICK/BOOKED, negativo = IMPRESSION sem CLICK).
model RecEvent {
  id           String       @id @default(uuid())
  requestId    String
  userId       String
  providerId   String
  type         RecEventType
  position     Int
  score        Float?
  modelVersion String?
  strategy     String?
  categoryId   String?
  createdAt    DateTime     @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId, createdAt])
  @@index([providerId, type])
}

/// Artefato do modelo treinado (joblib serializado). No Render free o
/// filesystem é efêmero, então o binário mora no Postgres e o serviço Python
/// faz apenas SELECT/INSERT — o Prisma segue dono do schema.
model MlModelArtifact {
  id           String   @id @default(uuid())
  version      String   @unique
  blob         Bytes
  metrics      Json?
  featureNames Json?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([isActive, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Outbox transacional. O ponto do padrão: o evento de domínio é gravado na MESMA
/// transação da mudança de estado que o originou, então ou os dois persistem ou
/// nenhum. Sem isto, `payment.confirmed` poderia commitar no Postgres e falhar ao
/// publicar no RabbitMQ — e como esse evento vira lançamento no ledger (Onda 7),
/// dinheiro sumiria. O relay lê as linhas com `publishedAt IS NULL`, publica com
/// confirm e marca `publishedAt`. O índice parcial dessa condição vive na migration
/// (Prisma não expressa `WHERE` em índice), e é o que mantém o polling barato mesmo
/// com a tabela crescendo para sempre.
model OutboxEvent {
  id          String    @id @default(uuid())
  routingKey  String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  // Correlation id da request HTTP que originou o evento. Viaja como header AMQP até o
  // consumidor, que o reidrata — é o que fecha o rastro ponta a ponta atravessando o
  // gap assíncrono do relay.
  requestId   String?
}

/// Deduplicação de consumo. Cada consumidor registra aqui os eventos que já tratou;
/// a chave composta permite que consumidores diferentes (notificações, analytics,
/// ledger) processem o MESMO evento uma vez cada. É o que torna o consumo idempotente
/// diante da entrega "at-least-once" do broker e das reentregas da DLQ.
model ProcessedEvent {
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@id([consumer, eventId])
}
