{
  "name": "zero-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go --lan",
    "start:mobile": "expo start --go --lan --clear --port 8081",
    "start:dev-client": "expo start --dev-client --lan",
    "start:tunnel": "expo start --go --tunnel",
    "start:lan": "expo start --go --lan",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "check:colors": "node scripts/check-colors.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "lint": "npm run typecheck && npm run check:colors && npm run check:contrast"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "axios": "^1.7.7",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.21",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
