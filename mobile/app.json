{
  "expo": {
    "name": "ZERO Marketplace",
    "slug": "zero-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.zero.marketplace"
    },
    "android": {
      "package": "dev.zero.marketplace"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ZELO usa sua localização para compartilhar seu deslocamento com o cliente enquanto o serviço está a caminho."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df8d313f-8677-478d-b7e8-b4e2ebdb2b73"
      }
    },
    "owner": "andreybertoletti"
  }
}
